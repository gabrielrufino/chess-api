HTTP_SERVER_PORT=3000
DATABASE_URL=mongodb://root:root@localhost:27017/chess_api?authSource=admin

# Authentication
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# Security
TRUST_PROXY=1

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Environment
NODE_ENV=development
